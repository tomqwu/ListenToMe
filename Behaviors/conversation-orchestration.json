    {
      "id": "ORCH-001",
      "name": "Load Calendar context without replacing a typed title",
      "given": "a current conversation and a calendar event with time, attendees and notes",
      "when": "the user loads that event as context",
      "then": "Context contains the event details, a generated title may become the event title, and an explicitly typed title is preserved",
      "covers": [
        "Sources/ListenToMeCore/CalendarContextCoordinator.swift",
        "App/MeetingView+Calendar.swift",
        "App/MeetingView.swift"
      ],
      "bindings": [
        {
          "suite": "core",
          "file": "Tests/ListenToMeCoreTests/MeetingContextTests.swift",
          "test": "MeetingContextTests/testIncludesAttendeesAndNotes"
        },
        {
          "suite": "core",
          "file": "Tests/ListenToMeCoreTests/ConversationAutoTitleTests.swift",
          "test": "ConversationAutoTitleTests/testCalendarReplacesDefaultAndAutomaticNamesButNeverTypedOnes"
        },
        {
          "suite": "core",
          "file": "Tests/ListenToMeCoreTests/CalendarContextCoordinatorTests.swift",
          "test": "CalendarContextCoordinatorTests/testCurrentEventFillsContextAndPreservesAnExplicitTitle"
        },
        {
          "suite": "core",
          "file": "Tests/ListenToMeCoreTests/CalendarContextCoordinatorTests.swift",
          "test": "CalendarContextCoordinatorTests/testFailureKeepsContextAndReturnsTheApplicableRecoveryMessage"
        },
        {
          "suite": "core",
          "file": "Tests/ListenToMeCoreTests/CalendarContextCoordinatorTests.swift",
          "test": "CalendarContextCoordinatorTests/testATitleTypedWhileCalendarIsPendingIsNotReplaced"
        }
      ]
    },
